---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site.js';
import { formatDate, runtime } from '../../lib/films.js';
import { getPosts } from '../../lib/posts';
import { url } from '../../lib/urls.js';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, next: posts[i + 1] ?? null },
  }));
}

const { post, next } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.description}>
  <article class="mx-auto max-w-2xl px-5 sm:px-8">
    <header class="mb-12 mt-14 text-center">
      <p class="label mb-4">
        {formatDate(post.data.date)} · Runtime {runtime(post.body ?? '')} min
        {post.data.tags.length > 0 && <> · {post.data.tags.join(' / ')}</>}
      </p>
      <h1 class="font-serif text-5xl leading-[1.05] text-screen sm:text-6xl">{post.data.title}</h1>
      {post.data.description && <p class="mx-auto mt-5 max-w-lg text-dim">{post.data.description}</p>}
    </header>

    <div class="prose-film">
      <Content />
    </div>

    <div class="mt-16 border-t border-line pt-8 text-center">
      <p class="label mb-2">Fin.</p>
      <p class="text-dim">Written by {site.name}. <a href={url('main')} class="text-gold hover:underline">Say hello</a></p>
    </div>

    {next && (
      <a href={url('blog', `/${next.id}`)} class="group mt-10 block rounded-md border border-line p-6 transition hover:border-gold/60">
        <span class="label">Up next</span>
        <span class="mt-1 block font-serif text-2xl text-screen group-hover:text-gold">{next.data.title}</span>
      </a>
    )}
  </article>
</Base>
