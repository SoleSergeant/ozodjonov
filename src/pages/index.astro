---
import Base from '../layouts/Base.astro';
import SocialIcon from '../components/SocialIcon.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { site } from '../data/site.js';
import { allEntries } from '../data/movies.js';
import { posterUrl, uniqueFilms } from '../lib/films.js';
import { url } from '../lib/urls.js';

// Background: a blurred wall of posters from the film diary, newest first.
const wall = uniqueFilms.map(posterUrl).filter(Boolean).slice(0, 24);
const initials = site.fullName.split(/\s+/).map((w) => w[0]).slice(0, 2).join('');
---

<Base bare>
  <section class="relative isolate flex min-h-svh items-center justify-center overflow-hidden px-5 py-16">
    <ThemeToggle class="absolute right-5 top-5 z-10 sm:right-8 sm:top-7" />
    <!-- Poster wall, blurred and darkened -->
    <div aria-hidden="true" class="absolute inset-0 -z-10">
      <div class="absolute -inset-10 grid scale-110 grid-cols-4 gap-2 opacity-90 blur-[6px] sm:grid-cols-6 lg:grid-cols-8">
        {wall.map((src) => <img src={src} alt="" class="aspect-[2/3] w-full object-cover" />)}
      </div>
      <div class="wall-shade absolute inset-0 bg-ink/65"></div>
      <div class="absolute inset-0" style="background: radial-gradient(ellipse at center, transparent 0%, color-mix(in srgb, var(--color-ink) 75%, transparent) 70%, var(--color-ink) 100%)"></div>
    </div>

    <div class="intro flex flex-col items-center text-center">
      <div class="h-44 w-44 overflow-hidden rounded-full bg-reel ring-1 ring-line sm:h-52 sm:w-52">
        {site.photo ? (
          <img src={site.photo} alt={site.fullName} class="h-full w-full object-cover" />
        ) : (
          <div class="flex h-full w-full items-center justify-center font-serif text-6xl text-gold">{initials}</div>
        )}
      </div>

      <h1 class="mt-10 flex items-center gap-3 font-[family-name:var(--font-script)] whitespace-nowrap text-[clamp(1.3rem,6.2vw,3rem)] leading-tight text-screen sm:gap-4">
        <span aria-hidden="true" class="h-[3px] w-5 rounded bg-screen sm:w-7"></span>
        {site.fullName}
        <span aria-hidden="true" class="h-[3px] w-5 rounded bg-screen sm:w-7"></span>
      </h1>

      {site.role && <p class="mt-5 font-mono text-sm tracking-wide text-screen/85 sm:text-[15px]">{site.role}</p>}

      <nav aria-label="Contact" class="mt-8 flex items-center gap-7">
        {site.links.map((link) => (
          <a
            href={link.href}
            target={link.href.startsWith('http') ? '_blank' : undefined}
            rel={link.href.startsWith('http') ? 'noopener' : undefined}
            aria-label={link.label}
            title={link.label}
            class="block h-7 w-7 text-screen transition hover:-translate-y-0.5 hover:text-gold"
          >
            <SocialIcon href={link.href} label={link.label} />
          </a>
        ))}
      </nav>

      <nav aria-label="Sections" class="mt-14 flex items-center gap-4 font-mono text-xs uppercase tracking-[0.2em] text-dim">
        <a href={url('blog')} class="transition hover:text-gold">Blog</a>
        <span class="text-line">/</span>
        <a href={url('movie')} class="transition hover:text-gold">Movies <span class="text-faint">({allEntries.length})</span></a>
        <span class="text-line">/</span>
        <a href={url('cv')} class="transition hover:text-gold">CV</a>
      </nav>
    </div>
  </section>
</Base>

<style>
  .intro > * {
    animation: rise 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .intro > :nth-child(2) { animation-delay: 0.12s; }
  .intro > :nth-child(3) { animation-delay: 0.22s; }
  .intro > :nth-child(4) { animation-delay: 0.32s; }
  .intro > :nth-child(5) { animation-delay: 0.42s; }

  @keyframes rise {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .intro > * { animation: none; }
  }
</style>
