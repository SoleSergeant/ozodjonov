---
import Base from '../../layouts/Base.astro';
import Poster from '../../components/Poster.astro';
import { resolvedCollections } from '../../lib/films.js';

export function getStaticPaths() {
  return resolvedCollections.map((collection) => ({ params: { slug: collection.slug }, props: { collection } }));
}

const { collection } = Astro.props;
---

<Base title={collection.title} description={collection.line}>
  <div class="mx-auto max-w-5xl px-5 sm:px-8">
    <a href="/collections" class="mt-10 inline-block text-sm text-dim hover:text-gold">← All collections</a>
    <header class="mt-8">
      <p class="label mb-3">{collection.kind === 'theme' ? 'Theme' : 'Saga'} · {collection.items.length} titles</p>
      <h1 class="font-serif text-5xl leading-[1.05] text-screen sm:text-6xl">{collection.title}</h1>
      <p class="mt-4 max-w-lg font-serif text-2xl italic text-dim">{collection.line}</p>
    </header>

    <div class="mt-12 grid grid-cols-3 gap-x-3 gap-y-6 sm:grid-cols-5 sm:gap-x-4">
      {collection.items.map((film) => <Poster film={film} showBadge={false} />)}
    </div>
  </div>
</Base>
