---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
---

<Base title="Blog" description="Essays on leadership, MUN, building things, and films.">
  <div class="mx-auto max-w-3xl px-5 sm:px-8">
    <header class="mb-10 mt-12">
      <p class="label mb-3">The blog</p>
      <h1 class="font-serif text-5xl leading-tight text-screen sm:text-6xl">Thinking out loud.</h1>
    </header>
    <PostList posts={posts} />
  </div>
</Base>
