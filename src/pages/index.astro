---
// ozodjonov.com: the title page of a screenplay, a headshot, the latest scene (post),
// and cuts to the other parts of the site. One screen on desktop.
import Base from '../layouts/Base.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { site } from '../data/site.js';
import { allEntries } from '../data/movies.js';
import { getPosts } from '../lib/posts';
import { formatDate, runtime } from '../lib/films.js';
import { url } from '../lib/urls.js';

const posts = await getPosts();
const latest = posts[0];
const cuts = [
  { label: 'The film diary', note: `${allEntries.length} titles`, href: url('movie') },
  { label: 'All scenes', note: 'the blog', href: url('blog') },
  { label: 'The CV', note: 'the résumé', href: url('cv') },
];
---

<Base bare>
  <div class="relative mx-auto flex min-h-svh max-w-5xl flex-col justify-center px-5 py-16 sm:px-8 lg:py-6">
    <ThemeToggle class="absolute right-5 top-5 sm:right-8" />

    <div class="grid gap-14 lg:grid-cols-2 lg:gap-20">
      <div class="flex flex-col">
        <header class="text-center">
          <h1 class="text-3xl font-bold uppercase tracking-[0.06em] text-screen underline decoration-2 underline-offset-8 sm:text-4xl">Ozodjonov</h1>
          <p class="mt-5 text-dim lg:mt-3">an ongoing screenplay</p>
          <p class="mt-6 text-dim lg:mt-4">written by</p>
          <p class="mt-1 text-lg text-screen">{site.fullName}</p>
        </header>

        <div class="mt-10 space-y-4 leading-relaxed lg:mt-6 lg:space-y-3">
          <p class="text-screen">FADE IN:</p>
          <p class="font-bold uppercase text-screen">Int. A bus in Fergana — Morning</p>
          <p class="text-prose">
            Window seat. Headphones on. The same road to school as every day. MUHAMMADJON watches it like a film.
          </p>
          <div class="mx-auto max-w-xs text-prose">
            <p class="text-center text-screen">MUHAMMADJON</p>
            <p>I am not the person I want to be.</p>
            <p class="text-center text-dim">(beat)</p>
            <p>But I know who I am. And I know I can't be him.</p>
          </div>
        </div>

        <nav aria-label="Sections" class="mt-8 space-y-1 text-right lg:mt-4 lg:space-y-0">
          {cuts.map((c) => (
            <a href={c.href} class="group block py-1 text-screen">
              CUT TO: <span class="uppercase underline decoration-line underline-offset-4 group-hover:text-gold group-hover:decoration-gold">{c.label}</span>
              <span class="text-faint"> ({c.note})</span>
            </a>
          ))}
        </nav>
      </div>

      <div class="flex flex-col items-center justify-center gap-10 lg:items-stretch">
        {site.photo && (
          <figure class="group relative mx-auto w-52 -rotate-2 border border-line bg-reel p-2 pb-3 shadow-sm transition duration-500 hover:rotate-0 motion-reduce:rotate-0 sm:w-56 lg:mx-0">
            {/* A headshot clipped to the script: black and white, tilted, color and straight on hover. */}
            <svg aria-hidden="true" viewBox="0 0 20 52" class="absolute -top-5 left-7 z-10 h-14 w-5 rotate-6 text-faint">
              <path d="M7 34V10a4.5 4.5 0 0 1 9 0v28a7 7 0 0 1-14 0V14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
            </svg>
            <div class="aspect-[4/5] overflow-hidden">
              {/* shortcut: the zoom is tuned to the current photo's framing; adjust if the photo changes. */}
              <img src={site.photo} alt={site.fullName} width="480" height="600" class="h-full w-full origin-[51%_42%] scale-[1.45] object-cover grayscale contrast-110 transition duration-500 group-hover:grayscale-0" />
            </div>
            <figcaption class="label mt-2">Muhammadjon · Fergana</figcaption>
          </figure>
        )}

        {latest && (
          <section aria-labelledby="latest" class="w-full">
            <h2 id="latest" class="label mb-3">Latest scene</h2>
            <a href={url('blog', `/${latest.id}`)} class="group block border-y border-line py-4">
              <span class="font-bold uppercase text-screen group-hover:text-gold">{posts.length}. {latest.data.title}</span>
              {latest.data.description && <span class="mt-1 block font-[family-name:var(--font-read)] text-[17px] text-dim">{latest.data.description}</span>}
              <span class="label mt-2 block">{formatDate(latest.data.date)} · {runtime(latest.body ?? '')} min · <span class="text-gold">Read →</span></span>
            </a>
          </section>
        )}
      </div>
    </div>

    <footer id="contact" class="mt-14 border-t border-line pt-4 text-sm text-dim lg:mt-6">
      <ul class="flex flex-wrap gap-x-5 gap-y-1">
        <li class="label self-center">Contact</li>
        {site.links.map((link) => (
          <li>
            <a
              href={link.href}
              target={link.href.startsWith('http') ? '_blank' : undefined}
              rel={link.href.startsWith('http') ? 'noopener' : undefined}
              class="inline-block py-1 hover:text-gold"
            >{link.handle ?? link.label}</a>
          </li>
        ))}
      </ul>
    </footer>
  </div>
</Base>
