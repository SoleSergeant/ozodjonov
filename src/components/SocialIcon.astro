---
// Picks an icon for a contact link from its address (or label), e.g. t.me -> Telegram.
import linkedin from '@tabler/icons/outline/brand-linkedin.svg?raw';
import instagram from '@tabler/icons/outline/brand-instagram.svg?raw';
import telegram from '@tabler/icons/outline/brand-telegram.svg?raw';
import github from '@tabler/icons/outline/brand-github.svg?raw';
import facebook from '@tabler/icons/outline/brand-facebook.svg?raw';
import x from '@tabler/icons/outline/brand-x.svg?raw';
import youtube from '@tabler/icons/outline/brand-youtube.svg?raw';
import tiktok from '@tabler/icons/outline/brand-tiktok.svg?raw';
import mail from '@tabler/icons/outline/mail.svg?raw';
import world from '@tabler/icons/outline/world.svg?raw';

interface Props {
  href: string;
  label: string;
}

const { href, label } = Astro.props;
const text = `${href} ${label}`.toLowerCase();
const icons: [RegExp, string][] = [
  [/linkedin/, linkedin],
  [/instagram/, instagram],
  [/t\.me|telegram/, telegram],
  [/github/, github],
  [/facebook|fb\.com/, facebook],
  [/twitter|x\.com/, x],
  [/youtube|youtu\.be/, youtube],
  [/tiktok/, tiktok],
  [/mailto:|email/, mail],
];
const svg = (icons.find(([re]) => re.test(text))?.[1] ?? world)
  .replace(/width="24"/, 'width="100%"')
  .replace(/height="24"/, 'height="100%"');
---

<Fragment set:html={svg} />
