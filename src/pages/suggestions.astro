---
// Private list of film suggestions from visitors. Protected by a password set in
// Vercel as SUGGESTIONS_PASSWORD (the browser asks for it; any username works).
import Base from '../layouts/Base.astro';
import { env, redisEnabled } from '../lib/server';
import { deleteSuggestion, listSuggestions, type Suggestion } from '../lib/suggestions';

export const prerender = false;

Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
Astro.response.headers.set('Cache-Control', 'no-store');

// Only on www (and localhost), not on the blog., movie. or cv. subdomains.
if (/^(blog|movie|cv)\./.test(Astro.url.hostname)) {
  return new Response('Not found', { status: 404 });
}

const password = env('SUGGESTIONS_PASSWORD');

function authorized(header: string | null) {
  if (!password || !header?.startsWith('Basic ')) return false;
  try {
    const given = atob(header.slice(6)).split(':').slice(1).join(':');
    // Compare without stopping at the first difference.
    let diff = given.length ^ password.length;
    for (let i = 0; i < Math.max(given.length, password.length); i++) {
      diff |= (given.charCodeAt(i) || 0) ^ (password.charCodeAt(i) || 0);
    }
    return diff === 0;
  } catch {
    return false;
  }
}

const ok = authorized(Astro.request.headers.get('authorization'));
if (password && !ok) {
  return new Response('Password required.', {
    status: 401,
    headers: { 'WWW-Authenticate': 'Basic realm="Film suggestions", charset="UTF-8"', 'X-Robots-Tag': 'noindex' },
  });
}

let suggestions: Suggestion[] = [];
let error = '';
if (ok && redisEnabled) {
  if (Astro.request.method === 'POST') {
    // The browser resends the password on its own, so only accept deletes made from this page,
    // never a form on another site.
    if (Astro.request.headers.get('origin') !== Astro.url.origin) {
      return new Response('Forbidden', { status: 403 });
    }
    const form = await Astro.request.formData();
    const id = String(form.get('delete') ?? '');
    if (/^(movie|tv|text)-[a-z0-9-]{1,60}$/.test(id)) await deleteSuggestion(id);
    return Astro.redirect('/suggestions', 303);
  }
  try {
    suggestions = await listSuggestions();
  } catch {
    error = 'Couldn’t load suggestions from the database.';
  }
}

const sort = Astro.url.searchParams.get('sort') === 'popular' ? 'popular' : 'recent';
if (sort === 'popular') suggestions.sort((a, b) => b.count - a.count || b.last - a.last);
const when = (t: number) => (t ? new Date(t).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : '');
const total = suggestions.reduce((n, s) => n + s.count, 0);
---

<Base title="Suggestions" description="Film suggestions from visitors.">
  <div class="mx-auto max-w-3xl px-5 sm:px-8">
    <header class="mb-10 mt-12">
      <p class="label mb-3">Private · Your mailbox</p>
      <h1 class="font-serif text-5xl leading-tight text-screen sm:text-6xl">Film suggestions</h1>
      {!password && (
        <p class="mt-4 text-dim">
          Set <code class="text-gold">SUGGESTIONS_PASSWORD</code> in Vercel's environment variables and redeploy to open this page.
        </p>
      )}
      {password && !redisEnabled && <p class="mt-4 text-dim">The database isn't connected.</p>}
      {ok && redisEnabled && !error && (
        <p class="mt-4 text-dim">
          {suggestions.length} {suggestions.length === 1 ? 'film' : 'films'} from {total} {total === 1 ? 'suggestion' : 'suggestions'} ·
          <a href="?sort=recent" class:list={[sort === 'recent' ? 'text-gold' : 'hover:text-screen']}> newest</a> ·
          <a href="?sort=popular" class:list={[sort === 'popular' ? 'text-gold' : 'hover:text-screen']}> most suggested</a>
        </p>
      )}
      {error && <p class="mt-4 text-danger">{error}</p>}
    </header>

    {ok && redisEnabled && !error && suggestions.length === 0 && (
      <p class="border-t border-line py-8 text-dim">No suggestions yet. They'll show up here.</p>
    )}

    <ul>
      {suggestions.map((s) => (
        <li class="flex gap-5 border-t border-line py-6">
          <div class="h-[105px] w-[70px] shrink-0 overflow-hidden rounded-[3px] bg-reel ring-1 ring-line">
            {s.poster && <img src={s.poster} alt="" loading="lazy" class="h-full w-full object-cover" />}
          </div>
          <div class="min-w-0 flex-1">
            <div class="flex items-start justify-between gap-4">
              <div>
                <h2 class="font-serif text-2xl leading-tight text-screen">
                  {s.kind !== 'text' ? (
                    <a href={`https://www.themoviedb.org/${s.kind}/${s.id.split('-')[1]}`} target="_blank" rel="noopener" class="hover:text-gold">{s.title}</a>
                  ) : s.title}
                </h2>
                <p class="label mt-1">
                  {[s.year, s.kind === 'tv' ? 'Series' : s.kind === 'movie' ? 'Film' : 'Typed by hand', `Last ${when(s.last)}`].filter(Boolean).join(' · ')}
                </p>
              </div>
              <span class:list={['shrink-0 rounded-full px-3 py-1 font-mono text-xs', s.count > 1 ? 'bg-gold text-ink' : 'border border-line text-dim']}>
                ×{s.count}
              </span>
            </div>
            {s.notes.length > 0 && (
              <ul class="mt-3 space-y-2">
                {s.notes.map((n) => (
                  <li class="border-l-2 border-gold/50 pl-3 text-[15px] text-screen/90">
                    {n.note && <span>“{n.note}”</span>}
                    <span class="ml-1 text-sm text-faint">{n.name ? `— ${n.name}` : '— anonymous'}, {when(n.at)}</span>
                  </li>
                ))}
              </ul>
            )}
            <form method="post" class="mt-3" onsubmit="return confirm('Delete this suggestion?')">
              <button name="delete" value={s.id} class="text-xs text-faint hover:text-danger">Delete</button>
            </form>
          </div>
        </li>
      ))}
    </ul>
  </div>
</Base>
