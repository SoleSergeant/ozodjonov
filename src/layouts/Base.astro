---
import '../styles/global.css';
import { site } from '../data/site.js';
import { url, publicUrl, hosts } from '../lib/urls.js';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title?: string;
  /** Use this exact title (tab and link previews) instead of "<title> · <name>". */
  fullTitle?: string;
  description?: string;
  /** Hide the header and footer (used by the landing page). */
  bare?: boolean;
  /** 'article' for blog posts; shapes how link previews are shown. */
  type?: 'website' | 'article';
}

const { title, fullTitle, description = site.intro || site.tagline, bare = false, type = 'website' } = Astro.props;
const pageTitle = fullTitle ?? (title ? `${title} · ${site.name}` : `${site.fullName} - ${site.tagline}`);
const pageUrl = publicUrl(Astro.url.pathname.replace(/\/$/, '') || '/');
// Each kind of page has its own preview card, drawn by src/pages/og/[...card].png.ts.
const route = Astro.url.pathname.replace(/\/$/, '');
const card = /^\/blog\/[^/]+$/.test(route) ? route.slice(1)
  : route === '/blog' ? 'blog'
  : route === '/movies/suggest' ? 'suggest'
  : route.startsWith('/movies') || route.startsWith('/collections') ? 'movies'
  : route.startsWith('/cv') ? 'cv'
  : 'home';
const ogImage = `${hosts.main}/og/${card}.png`;
// Each subdomain is its own site; the header just says which one you're on.
const path = Astro.url.pathname;
const section = path.startsWith('/blog') ? { label: 'blog', href: url('blog') }
  : path.startsWith('/movies') || path.startsWith('/collections') ? { label: 'movies', href: url('movie') }
  : path.startsWith('/cv') ? { label: 'cv', href: url('cv') }
  : null;
// Blog and movies point to each other and home, like a script's right-aligned transitions.
const cuts = section?.label === 'blog' ? [{ label: 'Home', href: url('main') }, { label: 'Movies', href: url('movie') }]
  : section?.label === 'movies' ? [{ label: 'Home', href: url('main') }, { label: 'Blog', href: url('blog') }]
  : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f5ef" />
    <script is:inline>
      // Pick the theme before anything is drawn, so the page never flashes the wrong one:
      // the saved choice (a cookie shared across the subdomains), otherwise script paper.
      (function () {
        var saved = (document.cookie.match(/(?:^|; )theme=(light|dark)/) || [])[1];
        var theme = saved || 'light';
        // Also color the phone's browser bar to match.
        function setTheme(t) {
          document.documentElement.dataset.theme = t;
          document.querySelector('meta[name="theme-color"]').content = t === 'light' ? '#f7f5ef' : '#121110';
        }
        setTheme(theme);
        // The fade-from-black intro plays once per visit, not on every page (a session cookie
        // shared across the subdomains).
        if (/(?:^|; )intro=1/.test(document.cookie)) document.documentElement.classList.add('no-intro');
        var domain = location.hostname.endsWith('ozodjonov.com') ? '; domain=.ozodjonov.com' : '';
        document.cookie = 'intro=1; path=/; samesite=lax' + domain;
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="ozodjonov" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.fullName} · blog`} href={`${hosts.blog}/rss.xml`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Courier+Prime:ital,wght@0,400;0,700;1,400&family=Newsreader:ital,opsz,wght@0,6..72,400;1,6..72,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    {!bare && (
    <header class="mx-auto flex max-w-5xl items-center gap-3 px-5 py-6 sm:px-8">
      <a href={url('main')} class="transition hover:opacity-80">
        <img src="/logo-light.svg" alt={site.fullName} width="458" height="96" class="logo-for-dark h-7 w-auto sm:h-8" />
        <img src="/logo.svg" alt={site.fullName} width="458" height="96" class="logo-for-light h-7 w-auto sm:h-8" />
      </a>
      {section && (
        <>
          <span aria-hidden="true" class="text-line">/</span>
          <a href={section.href} class="font-mono text-sm tracking-wide text-dim transition hover:text-screen">{section.label}</a>
        </>
      )}
      <ThemeToggle class="ml-auto" />
    </header>
    )}
    {!bare && cuts.length > 0 && (
      <nav aria-label="Elsewhere" class="mx-auto -mt-3 max-w-5xl px-5 text-right text-[13px] uppercase text-dim sm:px-8">
        Cut to:{' '}
        {cuts.map((c, i) => (
          <>{i > 0 && <span aria-hidden="true" class="text-faint"> · </span>}<a href={c.href} class="inline-block py-2 text-screen underline decoration-line underline-offset-4 hover:text-gold hover:decoration-gold">{c.label}</a></>
        ))}
      </nav>
    )}

    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>

    {!bare && (
    <footer class="mt-24 border-t border-line">
      <div class="mx-auto max-w-5xl px-5 py-14 text-center sm:px-8">
        <p class="label mb-3">The end</p>
        <p class="font-serif text-xl uppercase text-screen">Written and directed by {site.name}</p>
        <p class="mt-4 flex flex-wrap justify-center gap-x-5 gap-y-2 text-sm text-dim">
          {site.links.map((l) => <a href={l.href} class="hover:text-gold">{l.label}</a>)}
        </p>
        <p class="label mt-8">© {new Date().getFullYear()} {site.fullName}</p>
      </div>
    </footer>
    )}
  </body>
</html>
