---
import { cardColor, posterUrl } from '../lib/films.js';
import { url } from '../lib/urls.js';

interface Props {
  collection: { slug: string; title: string; line: string; items: { title: string }[] };
}

const { collection } = Astro.props;
const stack = collection.items.slice(0, 3);
---

<a href={url('movie', `/collections/${collection.slug}`)} class="group block">
  <div class="relative flex aspect-[4/3] items-end justify-center overflow-hidden rounded-md bg-reel ring-1 ring-line transition group-hover:ring-gold/60">
    {stack.map((film, i) => {
      const src = posterUrl(film);
      const rot = [-8, 0, 8][stack.length === 1 ? 1 : stack.length === 2 ? i * 2 : i];
      return (
        <div
          class="absolute bottom-[-12%] aspect-[2/3] w-[38%] overflow-hidden rounded-[3px] shadow-xl ring-1 ring-black/40 transition duration-300 group-hover:bottom-[-6%]"
          style={`background:${cardColor(film.title)}; transform: translateX(${(i - (stack.length - 1) / 2) * 52}%) rotate(${rot}deg); z-index:${i === 1 ? 3 : 2}`}
        >
          {src ? (
            <img src={src} alt="" loading="lazy" class="h-full w-full object-cover" />
          ) : (
            <span class="block p-2.5 font-serif text-[15px] leading-tight text-white/90">{film.title}</span>
          )}
        </div>
      );
    })}
  </div>
  <div class="mt-3 flex items-baseline justify-between gap-3">
    <h3 class="font-serif text-2xl leading-tight text-screen group-hover:text-gold">{collection.title}</h3>
    <span class="label shrink-0">{collection.items.length} {collection.items.length === 1 ? 'title' : 'titles'}</span>
  </div>
  <p class="mt-1 text-sm text-dim">{collection.line}</p>
</a>
