---
// "Montage": a life in days. One square per day from 2 Nov 2026 on, a row of weeks per year,
// marking the days a post went up (accent) or a film was watched (ink). Films need a
// "Date watched" in the admin; older diary entries only know their year, so they aren't here.
import { getPosts } from '../lib/posts';
import { allEntries } from '../data/movies.js';
import { url } from '../lib/urls.js';

interface Props {
  /** How many of the latest events to list under the grid. */
  list?: number;
}
const { list: listLimit = 8 } = Astro.props;

const START = '2026-11-02';
const iso = (d: Date) => d.toISOString().slice(0, 10);
const nice = (date: string) =>
  new Date(date + 'T00:00:00Z').toLocaleDateString('en-GB', { day: '2-digit', month: 'short', timeZone: 'UTC' }).toUpperCase();

type Event = { kind: 'post' | 'film'; title: string; href: string; date: string };
const events: Event[] = [
  ...(await getPosts())
    .filter((p) => iso(p.data.date) >= START)
    .map((p) => ({ kind: 'post' as const, title: p.data.title, href: url('blog', `/${p.id}`), date: iso(p.data.date) })),
  ...allEntries
    .filter((f) => f.watched && f.watched >= START)
    .map((f) => ({ kind: 'film' as const, title: f.title, href: url('movie'), date: f.watched as string })),
].sort((a, b) => b.date.localeCompare(a.date));

const byDay = new Map<string, Event[]>();
for (const e of events) byDay.set(e.date, [...(byDay.get(e.date) ?? []), e]);

// The page is rebuilt whenever content changes, so "today" is the last build.
const today = iso(new Date());

// A rolling window of WEEKS weeks (Monday to Sunday): from the start until it fills up,
// then the latest weeks. Days before 2 Nov 2026 are blank.
const WEEKS = 26;
const startMonday = new Date(`${START}T00:00:00Z`);
const firstMonday = new Date(Math.max(startMonday.getTime(), new Date(`${today}T00:00:00Z`).getTime() - (WEEKS - 1) * 7 * 864e5));
firstMonday.setUTCDate(firstMonday.getUTCDate() - ((firstMonday.getUTCDay() + 6) % 7));
const weeks = Array.from({ length: WEEKS }, (_, w) => {
  let month: string | undefined;
  const days = Array.from({ length: 7 }, (_, i) => {
    const date = new Date(firstMonday.getTime() + (w * 7 + i) * 864e5);
    const d = iso(date);
    if (date.getUTCDate() === 1 || (w === 0 && i === 0)) {
      month = date.toLocaleDateString('en-GB', { month: 'short', timeZone: 'UTC' }).toUpperCase();
    }
    return d >= START ? d : null;
  });
  return { days, month };
});

const describe = (list: Event[]) => list.map((e) => (e.kind === 'post' ? `Wrote “${e.title}”` : `Watched ${e.title}`)).join(' · ');
---

<section aria-labelledby="montage">
  <h2 id="montage" class="font-bold uppercase text-screen">Montage — a life in days</h2>
  <p class="mt-1 text-sm text-dim">
    One square a day since 2 November 2026.
    <span class="ml-2 whitespace-nowrap"><span class="inline-block h-2.5 w-2.5 bg-screen/75 align-middle"></span> film</span>
    <span class="ml-2 whitespace-nowrap"><span class="inline-block h-2.5 w-2.5 bg-gold align-middle"></span> post</span>
  </p>

  <div class="mt-4">
    <div class="grid gap-[3px]" style={`grid-template-columns: repeat(${WEEKS}, minmax(0, 13px))`}>
      {weeks.map((w) => <span class="h-4 overflow-visible whitespace-nowrap text-[10px] leading-4 text-faint">{w.month ?? ''}</span>)}
    </div>
    <div class="grid grid-flow-col grid-rows-7 gap-[3px]" style={`grid-template-columns: repeat(${WEEKS}, minmax(0, 13px))`}>
      {weeks.flatMap((w) =>
        w.days.map((d) => {
          if (!d) return <span aria-hidden="true" class="aspect-square"></span>;
          const list = byDay.get(d) ?? [];
          const post = list.find((e) => e.kind === 'post');
          const tip = `${nice(d)}${list.length ? `: ${describe(list)}` : ''}`;
          const tone = post ? 'bg-gold' : list.length ? 'bg-screen/75' : d > today ? 'border border-line' : 'bg-line';
          return post ? (
            <a href={post.href} title={tip} aria-label={tip} class:list={['aspect-square rounded-[2px] hover:opacity-70', tone]}></a>
          ) : (
            <span title={tip} class:list={['aspect-square rounded-[2px]', tone]}></span>
          );
        }),
      )}
    </div>
  </div>

  <ul class="mt-4 space-y-1 text-[15px]">
    {events.length === 0 && <li class="text-dim">— The montage starts today. Nothing on the reel yet.</li>}
    {events.slice(0, listLimit).map((e) => (
      <li class="text-dim">
        — {nice(e.date)}. {e.kind === 'post' ? 'Writes' : 'Watches'}{' '}
        <a href={e.href} class="uppercase text-screen underline decoration-line underline-offset-4 hover:text-gold hover:decoration-gold">{e.title}</a>.
      </li>
    ))}
  </ul>
</section>
