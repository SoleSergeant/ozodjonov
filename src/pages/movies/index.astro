---
import Base from '../../layouts/Base.astro';
import Poster from '../../components/Poster.astro';
import ActorPhoto from '../../components/ActorPhoto.astro';
import { diary, years, allEntries } from '../../data/movies.js';
import { actors } from '../../data/people.js';
import { findFilms } from '../../lib/films.js';

const stats = [
  { value: allEntries.length, label: 'Titles' },
  { value: years.length, label: 'Years' },
  { value: allEntries.filter((f) => f.rw).length, label: 'Rewatches' },
  { value: allEntries.filter((f) => f.uz).length, label: 'Uzbek films' },
];

const filters = [
  { id: 'all', label: 'All' },
  ...years.map((y) => ({ id: String(y), label: String(y) })),
  { id: 'rw', label: 'Rewatches' },
  { id: 'uz', label: 'Uzbek cinema' },
  { id: 'tv', label: 'Series' },
];

const leadingMen = actors.map((a) => ({ ...a, count: findFilms(a.films, `actor "${a.slug}"`).length }));
---

<Base title="Movies" description="A diary of every film and series I've watched since 2024.">
  <div class="mx-auto max-w-5xl px-5 sm:px-8">
    <header class="mt-12">
      <p class="label mb-3">Now showing · The film diary</p>
      <h1 class="font-serif text-5xl leading-[1.05] text-screen sm:text-6xl">
        Every film I've watched,<br /><em class="text-gold">and what stayed with me.</em>
      </h1>
    </header>

    <dl class="mt-10 grid grid-cols-2 gap-6 sm:grid-cols-4">
      {stats.map((s) => (
        <div class="border-t border-line pt-3">
          <dd class="font-serif text-4xl text-screen">{s.value}</dd>
          <dt class="label mt-1">{s.label}</dt>
        </div>
      ))}
    </dl>

    <section class="mt-16">
      <p class="label mb-5">The leading men</p>
      <div class="grid grid-cols-2 gap-6 sm:grid-cols-4">
        {leadingMen.map((a) => (
          <a href={`/movies/actors/${a.slug}`} class="group text-center">
            <ActorPhoto actor={a} class="mx-auto w-28 text-3xl sm:w-32" />
            <p class="mt-3 text-screen group-hover:text-gold">{a.name}</p>
            <p class="label mt-1">{a.count} titles</p>
          </a>
        ))}
      </div>
    </section>

    <div class="sticky top-0 z-10 -mx-5 mt-16 bg-ink/90 px-5 py-4 backdrop-blur sm:-mx-8 sm:px-8" role="toolbar" aria-label="Filter the diary">
      <div class="flex flex-wrap gap-2">
        {filters.map((f, i) => (
          <button
            type="button"
            data-filter={f.id}
            aria-pressed={i === 0 ? 'true' : 'false'}
            class="filter rounded-full border border-[#3a362f] px-3.5 py-1.5 text-[13px] text-dim transition hover:border-gold hover:text-screen aria-pressed:border-gold aria-pressed:bg-gold aria-pressed:text-ink"
          >
            {f.label}
          </button>
        ))}
      </div>
    </div>

    {years.map((year) => (
      <section class="year-block mt-10" data-year={year}>
        <p class="label mb-5">
          {year} · <span class="year-count">{diary[year].length}</span> titles
        </p>
        <div class="grid grid-cols-3 gap-x-3 gap-y-6 sm:grid-cols-5 lg:grid-cols-6 sm:gap-x-4">
          {diary[year].map((film) => <Poster film={{ ...film, year }} />)}
        </div>
      </section>
    ))}
    <p id="empty" hidden class="mt-10 text-dim">Nothing here yet.</p>
  </div>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter');
  const blocks = document.querySelectorAll<HTMLElement>('.year-block');

  function apply(filter: string) {
    let shown = 0;
    blocks.forEach((block) => {
      let count = 0;
      block.querySelectorAll<HTMLElement>('.poster').forEach((p) => {
        const match =
          filter === 'all' ||
          (/^\d{4}$/.test(filter) ? p.dataset.year === filter : p.dataset[filter] === '1');
        p.hidden = !match;
        if (match) count++;
      });
      block.hidden = count === 0;
      block.querySelector('.year-count')!.textContent = String(count);
      shown += count;
    });
    document.getElementById('empty')!.hidden = shown > 0;
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === filter)));
  }

  buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.filter!)));
</script>
