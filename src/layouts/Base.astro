---
import '../styles/global.css';
import { site } from '../data/site.js';
import { url, publicUrl, hosts } from '../lib/urls.js';

interface Props {
  title?: string;
  /** Use this exact title (tab and link previews) instead of "<title> · <name>". */
  fullTitle?: string;
  description?: string;
  /** Hide the header and footer (used by the landing page). */
  bare?: boolean;
  /** 'article' for blog posts; shapes how link previews are shown. */
  type?: 'website' | 'article';
}

const { title, fullTitle, description = site.intro || site.tagline, bare = false, type = 'website' } = Astro.props;
const pageTitle = fullTitle ?? (title ? `${title} · ${site.name}` : `${site.fullName} - ${site.tagline}`);
const pageUrl = publicUrl(Astro.url.pathname.replace(/\/$/, '') || '/');
const ogImage = `${hosts.main}/og.png`;
// Each subdomain is its own site; the header just says which one you're on.
const path = Astro.url.pathname;
const section = path.startsWith('/blog') ? { label: 'blog', href: url('blog') }
  : path.startsWith('/movies') || path.startsWith('/collections') ? { label: 'movies', href: url('movie') }
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="ozodjonov" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ozodjonov" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500&family=JetBrains+Mono:wght@400&family=Kaushan+Script&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    {!bare && (
    <header class="mx-auto flex max-w-5xl items-center gap-3 px-5 py-6 sm:px-8">
      <a href={url('main')} class="transition hover:opacity-80">
        <img src="/logo-light.svg" alt={site.fullName} width="458" height="96" class="h-7 w-auto sm:h-8" />
      </a>
      {section && (
        <>
          <span aria-hidden="true" class="text-line">/</span>
          <a href={section.href} class="font-mono text-sm tracking-wide text-dim transition hover:text-screen">{section.label}</a>
        </>
      )}
    </header>
    )}

    <main>
      <slot />
    </main>

    {!bare && (
    <footer class="mt-24 border-t border-line">
      <div class="mx-auto max-w-5xl px-5 py-14 text-center sm:px-8">
        <p class="label mb-3">End credits</p>
        <p class="font-serif text-3xl text-screen">Written and directed by {site.name}</p>
        <p class="mt-4 flex flex-wrap justify-center gap-x-5 gap-y-2 text-sm text-dim">
          {site.links.map((l) => <a href={l.href} class="hover:text-gold">{l.label}</a>)}
        </p>
        <p class="label mt-8">© {new Date().getFullYear()} {site.fullName}</p>
      </div>
    </footer>
    )}
  </body>
</html>
