---
// cv.ozodjonov.com: the CV, edited in the admin under "CV". One column, in the order a reader
// skims (who, education, experience, projects, honors, skills); prints as a clean one-page A4.
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site.js';
import cv from '../../content/cv.json';

// Contact line: place, email, then the site and the public profiles (no messaging apps).
const links = [
  { label: 'ozodjonov.com', href: 'https://www.ozodjonov.com' },
  ...site.links
    .filter((l) => /github|linkedin/i.test(l.href))
    .map((l) => ({ label: l.href.replace(/^https?:\/\/(www\.)?/, ''), href: l.href })),
];
const short = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '');
---

<Base fullTitle={`${site.fullName} · CV`} description={cv.summary}>
  <article class="cv mx-auto max-w-3xl px-5 sm:px-8">
    <header class="mt-10 flex flex-col gap-6 sm:mt-14 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <p class="label mb-4 print:hidden">Curriculum vitae</p>
        <h1 class="cv-name text-3xl font-bold uppercase leading-tight text-screen sm:text-4xl">{site.fullName}</h1>
        <p class="cv-headline mt-2 text-gold">{cv.headline}</p>
        <p class="cv-contact mt-3 flex flex-wrap gap-x-3 gap-y-1 text-sm text-dim">
          <span>{cv.location}</span>
          {cv.email && <><span aria-hidden="true" class="text-faint">·</span><a href={`mailto:${cv.email}`} class="hover:text-gold">{cv.email}</a></>}
          {cv.phone && <><span aria-hidden="true" class="text-faint">·</span><a href={`tel:${cv.phone.replace(/\s/g, '')}`} class="hover:text-gold">{cv.phone}</a></>}
          {links.map((l) => <><span aria-hidden="true" class="text-faint">·</span><a href={l.href} class="hover:text-gold">{l.label}</a></>)}
        </p>
      </div>
      <button
        type="button"
        id="print"
        class="inline-flex shrink-0 items-center gap-2 self-start rounded-full border border-gold/60 px-5 py-2.5 text-sm text-gold transition hover:bg-gold hover:text-ink print:hidden"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12m0 0-4-4m4 4 4-4M5 21h14" /></svg>
        Download PDF
      </button>
    </header>

    <p class="cv-summary mt-8 font-[family-name:var(--font-read)] text-xl leading-relaxed text-prose">{cv.summary}</p>

    {cv.stats.length > 0 && (
      <dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-4 sm:grid-cols-4 print:hidden">
        {cv.stats.map((s) => (
          <div class="border-t border-line pt-2">
            <dd class="text-2xl font-bold text-screen">{s.value}</dd>
            <dt class="label mt-1">{s.label}</dt>
          </div>
        ))}
      </dl>
    )}

    <section class="cv-section">
      <h2>Education</h2>
      {cv.education.map((e) => (
        <div class="cv-item">
          <div class="cv-row">
            <h3>{e.school}</h3>
            <p class="cv-when">{e.start} – {e.end}</p>
          </div>
          <p class="text-dim">{e.focus} · {e.place}</p>
        </div>
      ))}
      {cv.tests?.length > 0 && <p class="mt-2 text-screen">{cv.tests.map((t) => `${t.name} ${t.score}`).join(' · ')}</p>}
    </section>

    <section class="cv-section">
      <h2>Experience</h2>
      <ol class="cv-list">
        {cv.experience.map((job) => (
          <li class="cv-item">
            <div class="cv-row">
              <h3>{job.organization}<span class="cv-role">, {job.role}</span></h3>
              <p class="cv-when">{job.start} – {job.end}</p>
            </div>
            {job.about && <p class="cv-about">{job.about}</p>}
            <ul class="cv-points">
              {job.points.map((p) => <li>{p}</li>)}
            </ul>
          </li>
        ))}
      </ol>
    </section>

    {cv.projects?.length > 0 && (
      <section class="cv-section">
        <h2>Projects</h2>
        <ul class="cv-list">
          {cv.projects.map((p) => (
            <li class="cv-item">
              <div class="cv-row">
                <h3>{p.name}</h3>
                <p class="cv-when">{p.tech}</p>
              </div>
              <p class="text-prose">{p.description}</p>
              {(p.github || p.live) && (
                <p class="cv-links mt-1 flex flex-wrap gap-x-4 text-sm">
                  {p.live && <a href={p.live} class="text-gold hover:underline">{short(p.live)}</a>}
                  {p.github && <a href={p.github} class="text-gold hover:underline">{short(p.github)}</a>}
                </p>
              )}
            </li>
          ))}
        </ul>
      </section>
    )}

    {cv.honors?.length > 0 && (
      <section class="cv-section">
        <h2>Honors</h2>
        <ul class="cv-list">
          {cv.honors.map((h) => (
            <li class="cv-item">
              <div class="cv-row">
                <h3>{h.title}</h3>
                <p class="cv-when">{h.year}</p>
              </div>
              <p class="text-prose">{h.detail}</p>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="cv-section">
      <h2>Skills</h2>
      <p class="text-prose"><span class="cv-key">Technical:</span> {cv.skills.join(', ')}</p>
      {cv.languages?.length > 0 && (
        <p class="mt-1 text-prose"><span class="cv-key">Languages:</span> {cv.languages.map((l) => `${l.language} (${l.level.toLowerCase()})`).join(', ')}</p>
      )}
    </section>
  </article>
</Base>

<script>
  // "Download PDF" opens the print dialog; choosing "Save as PDF" gives the one-page version below.
  document.getElementById('print')?.addEventListener('click', () => window.print());
</script>

<style is:global>
  .cv-section { margin-top: 2.5rem; border-top: 1px solid var(--color-line); padding-top: 1rem; }
  .cv-section h2 { margin-bottom: 0.9rem; font-size: 0.8rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-faint); }
  .cv-list > * + * { margin-top: 1.4rem; }
  .cv-row { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; column-gap: 1rem; }
  .cv-row h3 { font-weight: 700; text-transform: uppercase; color: var(--color-screen); }
  .cv-role { font-weight: 400; text-transform: none; color: var(--color-gold); }
  .cv-when { font-size: 0.85rem; color: var(--color-dim); }
  .cv-about { margin-top: 0.15rem; font-style: italic; color: var(--color-dim); }
  .cv-points { margin-top: 0.5rem; color: var(--color-prose); }
  .cv-points li { position: relative; padding-left: 1.1rem; }
  .cv-points li + li { margin-top: 0.3rem; }
  .cv-points li::before { content: '—'; position: absolute; left: 0; color: var(--color-faint); }
  .cv-key { font-weight: 700; color: var(--color-screen); }

  @media print {
    @page { size: A4; margin: 11mm 14mm; }
    html, body { background: #fff !important; animation: none !important; }
    body::after, body > header, body > footer, body > nav { display: none !important; }
    .cv { max-width: none; padding: 0; font-size: 9.6pt; line-height: 1.38; --color-screen: #111; --color-prose: #222; --color-dim: #444; --color-faint: #666; --color-line: #ccc; --color-gold: #7d1d14; }
    .cv header { margin-top: 0; }
    .cv-name { font-size: 20pt !important; }
    .cv-headline, .cv-contact { margin-top: 2pt !important; font-size: 9.6pt !important; }
    .cv-summary { margin-top: 8pt !important; font-size: 10.5pt !important; line-height: 1.4 !important; }
    .cv-section { margin-top: 9pt; padding-top: 5pt; }
    .cv-section h2 { margin-bottom: 4pt; font-size: 8pt; }
    .cv-list > * + * { margin-top: 7pt; }
    .cv-points { margin-top: 2pt; }
    .cv-points li + li { margin-top: 1pt; }
    .cv-item { break-inside: avoid; }
    .cv-links, .cv-when { font-size: 8.5pt !important; }
    .cv a { text-decoration: none; }
  }
</style>
