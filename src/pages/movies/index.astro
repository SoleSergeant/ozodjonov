---
import Base from '../../layouts/Base.astro';
import Poster from '../../components/Poster.astro';
import ActorPhoto from '../../components/ActorPhoto.astro';
import MovieTabs from '../../components/MovieTabs.astro';
import { url } from '../../lib/urls.js';
import { diary, years, allEntries } from '../../data/movies.js';
import { actors } from '../../data/people.js';
import { findFilms } from '../../lib/films.js';

const stats = [
  { value: allEntries.length, label: 'Titles' },
  { value: years.length, label: 'Years' },
  { value: allEntries.filter((f) => f.rw).length, label: 'Rewatches' },
  { value: allEntries.filter((f) => f.uz).length, label: 'Uzbek films' },
];

const filters = [
  { id: 'all', label: 'All' },
  ...years.map((y) => ({ id: String(y), label: String(y) })),
  { id: 'rw', label: 'Rewatches' },
  { id: 'uz', label: 'Uzbek cinema' },
  { id: 'tv', label: 'Series' },
];

// Actor names per title, so searching "pacino" finds his films.
const castByTitle = new Map();
for (const a of actors) for (const t of a.films) castByTitle.set(t, `${castByTitle.get(t) ?? ''} ${a.name}`.trim());

const leadingMen = actors.map((a) => ({ ...a, count: findFilms(a.films, `actor "${a.slug}"`).length }));
---

<Base title="Movies" description="A diary of every film and series I've watched since 2024.">
  <div class="mx-auto max-w-5xl px-5 sm:px-8">
    <MovieTabs active="diary" />
    <header class="mt-12">
      <p class="label mb-3">Now showing · The film diary</p>
      <h1 class="font-serif text-5xl leading-[1.05] text-screen sm:text-6xl">
        Every film I've watched,<br /><em class="text-gold">and what stayed with me.</em>
      </h1>
    </header>

    <dl class="mt-10 grid grid-cols-2 gap-6 sm:grid-cols-4">
      {stats.map((s) => (
        <div class="border-t border-line pt-3">
          <dd class="font-serif text-4xl text-screen">{s.value}</dd>
          <dt class="label mt-1">{s.label}</dt>
        </div>
      ))}
    </dl>

    <section class="mt-16">
      <p class="label mb-5">The leading men</p>
      <div class="grid grid-cols-2 gap-6 sm:grid-cols-4">
        {leadingMen.map((a) => (
          <a href={url('movie', `/actors/${a.slug}`)} class="group text-center">
            <ActorPhoto actor={a} class="mx-auto w-28 text-3xl sm:w-32" />
            <p class="mt-3 text-screen group-hover:text-gold">{a.name}</p>
            <p class="label mt-1">{a.count} titles</p>
          </a>
        ))}
      </div>
    </section>

    <!-- The search bar stays pinned only while scrolling through the diary. -->
    <div>
    <div class="sticky top-0 z-10 -mx-5 mt-16 bg-ink/90 px-5 py-4 backdrop-blur sm:-mx-8 sm:px-8">
      <label class="relative mb-3 block">
        <span class="sr-only">Search the diary</span>
        <svg aria-hidden="true" class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-faint" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
        <input
          id="search"
          type="search"
          autocomplete="off"
          spellcheck="false"
          placeholder={`Search ${allEntries.length} films, e.g. Godfather`}
          class="w-full rounded-full border border-[#3a362f] bg-reel py-2.5 pl-10 pr-4 text-[15px] text-screen placeholder:text-faint focus:border-gold focus:outline-none"
        />
      </label>
      <div class="flex flex-wrap gap-2" role="toolbar" aria-label="Filter the diary">
        {filters.map((f, i) => (
          <button
            type="button"
            data-filter={f.id}
            aria-pressed={i === 0 ? 'true' : 'false'}
            class="filter rounded-full border border-[#3a362f] px-3.5 py-1.5 text-[13px] text-dim transition hover:border-gold hover:text-screen aria-pressed:border-gold aria-pressed:bg-gold aria-pressed:text-ink"
          >
            {f.label}
          </button>
        ))}
      </div>
    </div>

    {years.map((year) => (
      <section class="year-block mt-10" data-year={year}>
        <p class="label mb-5">
          {year} · <span class="year-count">{diary[year].length}</span> titles
        </p>
        <div class="grid grid-cols-3 gap-x-3 gap-y-6 sm:grid-cols-5 lg:grid-cols-6 sm:gap-x-4">
          {diary[year].map((film) => <Poster film={{ ...film, year }} keywords={castByTitle.get(film.title)} />)}
        </div>
      </section>
    ))}
    <div id="empty" hidden class="mt-10">
      <p class="text-dim">No films match <span id="empty-query" class="text-screen"></span>. Not seen it yet, maybe.</p>
      <a id="empty-suggest" href={url('movie', '/suggest')} class="mt-3 inline-block text-sm text-gold hover:underline">Suggest it to me →</a>
    </div>

    </div>

    <a href={url('movie', '/suggest')} class="group mt-24 flex flex-col gap-2 rounded-lg border border-line bg-reel px-6 py-8 transition hover:border-gold/60 sm:flex-row sm:items-center sm:justify-between sm:px-10">
      <span>
        <span class="label block">Your turn</span>
        <span class="mt-1 block font-serif text-3xl text-screen group-hover:text-gold sm:text-4xl">What should I watch next?</span>
      </span>
      <span class="shrink-0 text-gold">Recommend me a film →</span>
    </a>
  </div>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter');
  const blocks = document.querySelectorAll<HTMLElement>('.year-block');
  const search = document.getElementById('search') as HTMLInputElement;
  let filter = 'all';

  // Loose matching: ignore case, accents, and the different apostrophes in Uzbek titles
  // (o' / o‘ / oʻ), so "otkan" finds "O'tkan kunlar" and "amelie" finds "Amélie".
  const fold = (s: string) =>
    s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, ' ').trim();
  const titles = new Map<HTMLElement, string>();
  document.querySelectorAll<HTMLElement>('.poster').forEach((p) => titles.set(p, fold(`${p.dataset.title ?? ''} ${p.dataset.keywords ?? ''}`)));
  const squash = (s: string) => s.replace(/ /g, '');

  function apply() {
    const words = fold(search.value).split(' ').filter(Boolean);
    let shown = 0;
    blocks.forEach((block) => {
      let count = 0;
      block.querySelectorAll<HTMLElement>('.poster').forEach((p) => {
        const title = titles.get(p)!;
        const matchesFilter =
          filter === 'all' || (/^\d{4}$/.test(filter) ? p.dataset.year === filter : p.dataset[filter] === '1');
        const matchesSearch = words.every((w) => title.includes(w) || squash(title).includes(w));
        const match = matchesFilter && matchesSearch;
        p.hidden = !match;
        if (match) count++;
      });
      block.hidden = count === 0;
      block.querySelector('.year-count')!.textContent = String(count);
      shown += count;
    });
    document.getElementById('empty')!.hidden = shown > 0;
    document.getElementById('empty-query')!.textContent = search.value.trim() ? `“${search.value.trim()}”` : 'this filter';
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === filter)));
  }

  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      filter = b.dataset.filter!;
      apply();
    }),
  );
  search.addEventListener('input', apply);
  // "Suggest it to me" carries the search text over to the suggestion page.
  const suggestLink = document.getElementById('empty-suggest') as HTMLAnchorElement;
  const suggestBase = suggestLink.href;
  search.addEventListener('input', () => {
    const q = search.value.trim();
    suggestLink.href = q ? `${suggestBase}?title=${encodeURIComponent(q)}` : suggestBase;
  });
  // Press "/" anywhere to jump to the search box.
  document.addEventListener('keydown', (e) => {
    if (e.key === '/' && document.activeElement !== search) {
      e.preventDefault();
      search.focus();
    }
  });
</script>
