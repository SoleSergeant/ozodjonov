---
// "Montage": a life in days. One square per day from 2 Nov 2026 on, marking the days a post went up (accent) or a film was watched (ink). Films need a
// "Date watched" in the admin; older diary entries only know their year, so they aren't here.
import { getPosts } from '../lib/posts';
import { allEntries } from '../data/movies.js';
import { url } from '../lib/urls.js';

interface Props {
  /** How many of the latest events to list under the grid; the rest fold away. */
  list?: number;
  /** Only films (the movie site), not posts. */
  filmsOnly?: boolean;
}
const { list: listLimit = 10, filmsOnly = false } = Astro.props;

const START = '2026-11-02';
const iso = (d: Date) => d.toISOString().slice(0, 10);
const nice = (date: string) =>
  new Date(date + 'T00:00:00Z').toLocaleDateString('en-GB', { day: '2-digit', month: 'short', timeZone: 'UTC' }).toUpperCase();

type Event = { kind: 'post' | 'film'; title: string; href: string; date: string };
const events: Event[] = [
  ...(filmsOnly ? [] : await getPosts())
    .filter((p) => iso(p.data.date) >= START)
    .map((p) => ({ kind: 'post' as const, title: p.data.title, href: url('blog', `/${p.id}`), date: iso(p.data.date) })),
  ...allEntries
    .filter((f) => f.watched && f.watched >= START)
    .map((f) => ({ kind: 'film' as const, title: f.title, href: url('movie'), date: f.watched as string })),
].sort((a, b) => b.date.localeCompare(a.date));

const byDay = new Map<string, Event[]>();
for (const e of events) byDay.set(e.date, [...(byDay.get(e.date) ?? []), e]);

// The page is rebuilt whenever content changes, so "today" is the last build.
const today = iso(new Date());

// Weeks run Monday to Sunday; days outside from..to are blank.
function weekGrid(from: string, to: string) {
  const cursor = new Date(`${from}T00:00:00Z`);
  cursor.setUTCDate(cursor.getUTCDate() - ((cursor.getUTCDay() + 6) % 7));
  const weeks: { days: (string | null)[]; month?: string }[] = [];
  while (iso(cursor) <= to) {
    let month: string | undefined;
    const days = Array.from({ length: 7 }, () => {
      const d = iso(cursor);
      const inRange = d >= from && d <= to;
      if (inRange && (cursor.getUTCDate() === 1 || d === from)) {
        month = cursor.toLocaleDateString('en-GB', { month: 'short', timeZone: 'UTC' }).toUpperCase();
      }
      cursor.setUTCDate(cursor.getUTCDate() + 1);
      return inRange ? d : null;
    });
    weeks.push({ days, month });
  }
  return weeks;
}

// One grid per year, newest first.
const lastYear = Math.max(Number(today.slice(0, 4)), ...events.map((e) => Number(e.date.slice(0, 4))));
const grids = Array.from({ length: lastYear - 2025 }, (_, i) => lastYear - i).map((y) => ({
  label: String(y),
  weeks: weekGrid(y === 2026 ? START : `${y}-01-01`, `${y}-12-31`),
}));

const describe = (list: Event[]) => list.map((e) => (e.kind === 'post' ? `Wrote “${e.title}”` : `Watched ${e.title}`)).join(' · ');
---

<section aria-labelledby="montage">
  <h2 id="montage" class="font-bold uppercase text-screen">Montage — a life in days</h2>
  <p class="mt-1 text-sm text-dim">
    One square a day since 2 November 2026.
    <span class="ml-2 whitespace-nowrap"><span class="inline-block h-2.5 w-2.5 bg-screen/75 align-middle"></span> film</span>
    {!filmsOnly && <span class="ml-2 whitespace-nowrap"><span class="inline-block h-2.5 w-2.5 bg-gold align-middle"></span> post</span>}
  </p>

  {grids.map(({ label, weeks }) => (
    <div class="mt-4 overflow-x-auto pb-1">
      <p class="label mb-1">{label}</p>
      <div class="grid gap-[3px]" style={`grid-template-columns: repeat(${weeks.length}, 11px)`}>
        {weeks.map((w) => <span class="h-4 overflow-visible whitespace-nowrap text-[10px] leading-4 text-faint">{w.month ?? ''}</span>)}
      </div>
      <div class="grid grid-flow-col grid-rows-7 gap-[3px]" style={`grid-template-columns: repeat(${weeks.length}, 11px)`}>
        {weeks.flatMap((w) =>
          w.days.map((d) => {
            if (!d) return <span aria-hidden="true" class="aspect-square"></span>;
            const list = byDay.get(d) ?? [];
            const post = list.find((e) => e.kind === 'post');
            const tip = `${nice(d)}${list.length ? `: ${describe(list)}` : ''}`;
            const tone = post ? 'bg-gold' : list.length ? 'bg-screen/75' : d > today ? 'border border-line' : 'bg-line';
            return post ? (
              <a href={post.href} title={tip} aria-label={tip} class:list={['aspect-square rounded-[2px] hover:opacity-70', tone]}></a>
            ) : (
              <span title={tip} class:list={['aspect-square rounded-[2px]', tone]}></span>
            );
          }),
        )}
      </div>
    </div>
  ))}

  {events.length === 0 && <p class="mt-4 text-[15px] text-dim">— The montage starts today. Nothing on the reel yet.</p>}
  {[events.slice(0, listLimit), events.slice(listLimit)].map((part, i) => {
    if (!part.length) return null;
    const items = part.map((e) => (
      <li class="text-dim">
        — {nice(e.date)}. {e.kind === 'post' ? 'Writes' : 'Watches'}{' '}
        {filmsOnly ? (
          <span class="uppercase text-screen">{e.title}</span>
        ) : (
          <a href={e.href} class="uppercase text-screen underline decoration-line underline-offset-4 hover:text-gold hover:decoration-gold">{e.title}</a>
        )}.
      </li>
    ));
    return i === 0 ? (
      <ul class="mt-4 space-y-1 text-[15px]">{items}</ul>
    ) : (
      <details class="mt-2 text-[15px]">
        <summary class="cursor-pointer text-gold hover:underline">All {events.length} entries</summary>
        <ul class="mt-2 space-y-1">{items}</ul>
      </details>
    );
  })}
</section>
