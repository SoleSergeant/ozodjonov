---
import { photoUrl } from '../lib/films.js';

interface Props {
  actor: { name: string; initials: string };
  class?: string;
  highlight?: boolean;
}

const { actor, class: className = '', highlight = false } = Astro.props;
const src = photoUrl(actor.name);
---

<div
  class:list={[
    'flex aspect-square shrink-0 items-center justify-center overflow-hidden rounded-full border bg-reel font-serif text-gold transition',
    highlight ? 'border-gold' : 'border-line group-hover:border-gold',
    className,
  ]}
>
  {src ? (
    <img
      src={src}
      alt={actor.name}
      loading="lazy"
      class:list={[
        'h-full w-full object-cover object-top transition duration-500',
        !highlight && 'grayscale group-hover:grayscale-0',
      ]}
    />
  ) : (
    actor.initials
  )}
</div>
