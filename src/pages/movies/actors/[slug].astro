---
import Base from '../../../layouts/Base.astro';
import Poster from '../../../components/Poster.astro';
import { actors } from '../../../data/people.js';
import { findFilms } from '../../../lib/films.js';

export function getStaticPaths() {
  return actors.map((actor) => ({ params: { slug: actor.slug }, props: { actor } }));
}

const { actor } = Astro.props;
const films = findFilms(actor.films, `actor "${actor.slug}"`);
---

<Base title={actor.name} description={`Every ${actor.name} film in my diary.`}>
  <div class="mx-auto max-w-5xl px-5 sm:px-8">
    <a href="/movies" class="mt-10 inline-block text-sm text-dim hover:text-gold">← The film diary</a>
    <header class="mt-8 flex flex-col items-start gap-6 sm:flex-row sm:items-center">
      <div class="flex aspect-square w-28 shrink-0 items-center justify-center rounded-full border border-gold bg-reel font-serif text-4xl text-gold">
        {actor.initials}
      </div>
      <div>
        <p class="label mb-2">The leading men · {films.length} titles</p>
        <h1 class="font-serif text-5xl leading-tight text-screen sm:text-6xl">{actor.name}</h1>
        <p class="mt-3 max-w-xl text-dim">{actor.note}</p>
      </div>
    </header>

    <div class="mt-12 grid grid-cols-3 gap-x-3 gap-y-6 sm:grid-cols-5 sm:gap-x-4">
      {films.map((film) => <Poster film={film} showBadge={false} />)}
    </div>
  </div>
</Base>
