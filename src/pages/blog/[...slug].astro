---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import LikeButton from '../../components/LikeButton.astro';
import { formatDate, runtime } from '../../lib/films.js';
import { excerpt, getPosts } from '../../lib/posts';
import { url } from '../../lib/urls.js';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, scene: posts.length - i, next: posts[i + 1] ?? null },
  }));
}

const { post, scene, next } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={excerpt(post)} type="article">
  <article class="mx-auto max-w-[40rem] px-5 sm:px-8">
    <header class="mb-12 mt-14">
      <p class="label mb-4">
        Scene {scene} · {formatDate(post.data.date)} · {runtime(post.body ?? '')} min
        {post.data.tags.length > 0 && <> · {post.data.tags.join(' / ')}</>}
      </p>
      <h1 class="text-3xl font-bold uppercase leading-tight text-screen sm:text-4xl">{post.data.title}</h1>
      {post.data.description && <p class="mt-4 font-[family-name:var(--font-read)] text-xl italic text-dim">{post.data.description}</p>}
    </header>

    <div class="prose-film">
      <Content />
    </div>

    <div class="mt-16 border-t border-line pt-8">
      <p class="text-right text-screen">FADE OUT.</p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-6">
        <LikeButton slug={post.id} size="lg" />
        <a href={`${url('main')}#contact`} class="text-gold hover:underline">What do you think?</a>
      </div>
    </div>

    {next && (
      <a href={url('blog', `/${next.id}`)} class="group mt-12 block border-t border-line pt-6 text-right">
        <span class="text-dim">CUT TO:</span>
        <span class="mt-1 block font-bold uppercase text-screen group-hover:text-gold">Scene {scene - 1}. {next.data.title}</span>
      </a>
    )}
  </article>
</Base>
